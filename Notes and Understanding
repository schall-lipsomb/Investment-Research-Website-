HOME.HTML

<!DOCTYPE html>
<html>
<head>
    <title>Investment Research</title>
</head>
<body>
    <h1>Investment Research Dashboard</h1>

    <h2>Your Watchlist</h2>
    {% if companies %}
        <ul>
        {% for company in companies %}
            <li>
                <a href="{{ url_for('company_profile', ticker=company.name) }}">
                    {{ company.name }} — ${{ company.current_price }}
                </a>
            </li>
        {% endfor %}
        </ul>
    {% else %}
        <p>Your watchlist is empty. Try visiting a company page to add one.</p>
    {% endif %}

    <p>Try visiting <a href="/company/AAPL">/company/AAPL</a> or <a href="/company/TSLA">/company/TSLA</a></p>
</body>
</html>
